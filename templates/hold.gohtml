<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{$.today}}</title>
</head>
<body>
<h4>市场价值表</h4>
<table border="1" cellspacing="0">
    <tr>
        <th>市场</th>
        <th>现货权益</th>
        <th>期货权益</th>
        <th>现货持仓</th>
        <th>期货持仓</th>
        <th>未实现盈亏</th>
    </tr>
    {{range $i, $value := $.marketValue}}
        <tr>
            <td>{{index $value 0}}</td>
            <td>{{index $value 1}}</td>
            <td>{{index $value 2}}</td>
            <td>{{index $value 3}}</td>
            <td>{{index $value 4}}</td>
            <td>{{index $value 5}}</td>
        </tr>
    {{end}}
</table>
<h4>交易概览表</h4>
<table border="1" cellspacing="0">
    <th>市场</th>
    <th>日期</th>
    <th>方向</th>
    <th>交易额/USD</th>
    <th>类型</th>
    <th>单数</th>
    <th>找平率</th>
    {{range $i, $value := $.trade}}
        <tr>
            <td>{{index $value 0}}</td>
            <td>{{index $value 1}}</td>
            <td>{{index $value 2}}</td>
            <td>{{index $value 3}}</td>
            <td>{{index $value 4}}</td>
            <td>{{index $value 5}}</td>
            <td>{{index $value 6}}%</td>
        </tr>
    {{end}}
</table>
<h4>近期失败下单</h4>
<table border="1" cellspacing="0">
    <th>id</th>
    <th>市场</th>
    <th>symbol</th>
    <th>时间</th>
    <th>方向</th>
    <th>价格</th>
    <th>数量</th>
    <th>类型</th>
    <th>err code</th>
    {{range $i, $value := $.orders}}
        <tr>
            <td>{{index $value 0}}</td>
            <td>{{index $value 1}}</td>
            <td>{{index $value 2}}</td>
            <td>{{index $value 3}}</td>
            <td>{{index $value 4}}</td>
            <td>{{index $value 5}}</td>
            <td>{{index $value 6}}</td>
            <td>{{index $value 7}}</td>
            <td>{{index $value 8}}</td>
            <td>{{index $value 9}}</td>
        </tr>
    {{end}}
</table>
<h4>持仓表</h4>
<table border="1" cellspacing="0">
    <th>market</th>
    <th>币种</th>
    <th>symbol</th>
    <th>数量</th>
    <th>价值U</th>
    <th>总值U</th>
    <th>valid</th>
    <th>price</th>
    <th>信息</th>
    {{range $i, $value := $.holdings}}
        <tr>
            {{$valid := index $value 5}}
            {{if eq $valid "false"}}
                <td bgcolor="#00FF00">{{index $value 0}}</td>
                <td bgcolor="#00FF00">{{index $value 1}}</td>
                <td bgcolor="#00FF00">{{index $value 2}}</td>
                <td bgcolor="#00FF00">{{index $value 3}}</td>
                <td bgcolor="#00FF00">{{index $value 4}}</td>
                <td bgcolor="#00FF00">{{index $value 7}}</td>
                <td bgcolor="#00FF00">{{index $value 5}}</td>
                <td bgcolor="#00FF00">{{index $value 8}}</td>
                <td bgcolor="#00FF00">{{index $value 6}}</td>
            {{else if eq $valid "extra"}}
                <td bgcolor="#FF0000">{{index $value 0}}</td>
                <td bgcolor="#FF0000">{{index $value 1}}</td>
                <td bgcolor="#FF0000">{{index $value 2}}</td>
                <td bgcolor="#FF0000">{{index $value 3}}</td>
                <td bgcolor="#FF0000">{{index $value 4}}</td>
                <td bgcolor="#FF0000">{{index $value 7}}</td>
                <td bgcolor="#FF0000">{{index $value 5}}</td>
                <td bgcolor="#FF0000">{{index $value 8}}</td>
                <td bgcolor="#FF0000">{{index $value 6}}</td>
            {{else if eq $valid "removed"}}
                <td bgcolor="#0000FF">{{index $value 0}}</td>
                <td bgcolor="#0000FF">{{index $value 1}}</td>
                <td bgcolor="#0000FF">{{index $value 2}}</td>
                <td bgcolor="#0000FF">{{index $value 3}}</td>
                <td bgcolor="#0000FF">{{index $value 4}}</td>
                <td bgcolor="#0000FF">{{index $value 7}}</td>
                <td bgcolor="#0000FF">{{index $value 5}}</td>
                <td bgcolor="#0000FF">{{index $value 8}}</td>
                <td bgcolor="#0000FF">{{index $value 6}}</td>
            {{else}}
                <td>{{index $value 0}}</td>
                <td>{{index $value 1}}</td>
                <td>{{index $value 2}}</td>
                <td>{{index $value 3}}</td>
                <td>{{index $value 4}}</td>
                <td>{{index $value 7}}</td>
                <td>{{index $value 5}}</td>
                <td>{{index $value 8}}</td>
                <td>{{index $value 6}}</td>
            {{end}}
        </tr>
    {{end}}
</table>
</body>
</html>