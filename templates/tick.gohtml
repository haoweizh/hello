<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{$.today}}</title>
</head>
<body>
<h4>价差表</h4>
<table border="1" cellspacing="0">
    <th>market</th>
    <th>symbol</th>
    <th>market</th>
    <th>symbol</th>
    <th>in all</th>
    <th>价差%</th>
    <th>均价差%</th>
    {{range $i, $value := $.priceDis}}
        <tr>
            <td>{{index $value 0}}</td>
            <td>{{index $value 1}}</td>
            <td>{{index $value 2}}</td>
            <td>{{index $value 3}}</td>
            <td>{{index $value 4}}</td>
            <td>{{index $value 5}}</td>
            <td>{{index $value 6}}</td>
        </tr>
    {{end}}
</table>
<h4>最近Tick表</h4>
<table border="1" cellspacing="0">
    <th>market</th>
    <th>symbol</th>
    <th>in all</th>
    <th><100</th>
    <th>delay</th>
    <th>间隔</th>
    {{range $i, $value := $.tickInfo}}
        <tr>
            <td>{{index $value 0}}</td>
            <td>{{index $value 1}}</td>
            <td>{{index $value 2}}</td>
            <td>{{index $value 3}}</td>
            <td>{{index $value 4}}</td>
            <td>{{index $value 5}}</td>
        </tr>
    {{end}}
</table>
<h4>历史Tick表</h4>
<table border="1" cellspacing="0">
    <th>market</th>
    <th>symbol</th>
    <th>time</th>
    <th>in all</th>
    <th>delay<100</th>
    <th>delay</th>
    {{range $i, $value := $.tickInfo}}
        <tr>
            <td>{{index $value 0}}</td>
            <td>{{index $value 1}}</td>
            <td>{{index $value 2}}</td>
            <td>{{index $value 3}}</td>
            <td>{{index $value 4}}</td>
            <td>{{index $value 5}}</td>
        </tr>
    {{end}}
</table>
</body>
</html>